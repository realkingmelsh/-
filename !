do
    print("--- Starting Script 4 ---")
 
    -- Executor-safe HipHeight slider + editable Max
-- LOCKED + RESPAWN-SAFE + SNAPS NEXT TO "Animation Speed Controller" GUI
-- PRESS "-" TO HIDE/UNHIDE | PRESS "T" TO TOGGLE BETWEEN 2.0 AND MAX
 
